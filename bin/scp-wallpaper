#!/usr/bin/env bash
# Everyday control for the SCP wallpaper project.   scp-wallpaper help
set -u
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
CACHE=$HOME/.cache/scp-center
INIR_CFG=$HOME/.config/illogical-impulse/config.json

age() {  # seconds since a file was modified, or "-"
  [ -f "$1" ] && echo "$(( $(date +%s) - $(stat -c %Y "$1") ))s ago" || echo "missing"
}

cmd_status() {
  echo "Project   $ROOT"
  python3 -I - "$INIR_CFG" <<'PY' 2>/dev/null || echo "iNiR config unreadable"
import json, sys
b = json.load(open(sys.argv[1])).get("background", {}).get("backend", {})
w = b.get("web", {})
print(f"iNiR      provider={b.get('provider')}  interactive={w.get('interactive')}\n          source={w.get('source')}")
PY
  echo "Services"
  printf '  %-16s %s\n' scp-wallpaperd "$(systemctl --user is-active scp-wallpaperd.service 2>&1)"
  "$ROOT/helpers/scp-wallpaperd" state 2>/dev/null | python3 -I -c 'import json,sys; d=json.load(sys.stdin); print("  covered outputs  " + (", ".join(k for k,v in d["pause"].items() if v) or "none"))' || true
  echo "Data files"
  for f in sysstats audio nowplaying control claude-usage; do printf '  %-16s updated %s\n' "$f.json" "$(age "$CACHE/$f.json")"; done
  echo "  (claude-usage.json only refreshes while a Claude Code session is running)"
  echo "Layer surfaces (expect one inir:web-wallpaper per output)"
  niri msg layers 2>/dev/null | awk '/^Output/ {o=$2; gsub(/[":]/, "", o)} /web-wallpaper/ {print "  " o ": web-wallpaper"}' | sort -u
  echo "iNiR patches"
  "$ROOT/patches/apply.sh" --check | sed 's/^/  /'
}

cmd_reload() {   # hosts are children of the shell: restarting it reloads the page
  pkill -x qs 2>/dev/null; sleep 2
  (setsid inir run >/tmp/scp-wallpaper-inir.log 2>&1 &)
  echo "shell restarted, waiting for the hosts..."; sleep 14
  niri msg layers 2>/dev/null | awk '/^Output/ {o=$2; gsub(/[":]/, "", o)} /web-wallpaper/ {print "  " o ": ok"}'
}

cmd_scenes() {
  i=0; for f in "$ROOT"/src/scenes/[0-9]*.ts; do
    printf '%2d  %-11s %s\n' "$i" "$(grep -o "id: '[^']*'" "$f" | head -1 | cut -d"'" -f2)" "$(sed -n 1p "$f" | sed 's#^// ##')"; i=$((i+1)); done
  echo; echo "widgets:"; for f in "$ROOT"/src/widgets/[0-9]*.ts; do printf '    %-11s %s\n' "$(grep -o "id: '[^']*'" "$f" | head -1 | cut -d"'" -f2)" "$(sed -n 1p "$f" | sed 's#^// ##')"; done
}

cmd_build() { (cd "$ROOT" && { [ -d node_modules ] || npm ci --silent; } && node tools/build.mjs "$@"); }

cmd_logs() { journalctl --user -u scp-wallpaperd -n "${1:-30}" --no-pager; }

send() { exec "$ROOT/helpers/scp-wallpaperd" send "$@"; }

case ${1:-help} in
  status)  cmd_status ;;
  reload)  cmd_build && cmd_reload ;;
  scenes)  cmd_scenes ;;
  build)   shift; cmd_build "$@" ;;
  scene|next|prev|reseed|dash|layout|widget|auto|edit|menu) send "$@" ;;
  refresh) shift; send reload "$@" ;;
  dev)     cmd_build --watch ;;
  check)   exec "$ROOT/tools/check.sh" ;;
  preview) shift; exec "$ROOT/tools/preview.sh" "$@" ;;
  patch)   shift; exec "$ROOT/patches/apply.sh" "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  install) shift; exec "$ROOT/install.sh" "$@" ;;
  edit)    ${EDITOR:-nano} "$ROOT/src/app/dashboard.ts" ;;
  help|-h|--help|*)
    cat <<H
scp-wallpaper <command>

  status            what is running, which page iNiR shows, data freshness, patch state
  build             bundle src/ into wallpaper/dist/app.js (runs npm ci the first time)
  dev               rebuild on every change in src/ and refresh the pages in place
  refresh           reload the pages in place (no shell restart); reload = build + restart the shell
  scenes            list scenes (index = menu order, id) and widgets
  preview N [png]   render scene N offscreen (SEED=… and a 3rd arg of hash params are supported)
  check             syntax + index.html consistency + shader + smoke test of every scene/widget
  patch [--check]   (re)apply the local iNiR patches, e.g. after ./setup update
  logs [N]          journal of scp-wallpaperd

Page commands (via scp-wallpaperd; add --screen DP-3 to target one monitor):
  scene ID|N        show a scene (ids: scp-wallpaper scenes)      next | prev | reseed
  dash on|off       dashboard visibility (no arg = toggle)         edit on|off | menu on|off
  layout 1-3        load a saved layout                            widget ID on|off
  auto MIN          auto-rotate every MIN minutes (0 = off)
  install [flags]   (re)do the installation (links, services, iNiR config, patches)

Docs: $ROOT/README.md and $ROOT/docs/
H
    ;;
esac
